{
  "name": "@reallygoodwork/coral-core",
  "version": "0.0.0-development",
  "description": "Core utility library for UI layers and tooling ecosystem",
  "files": [
    "dist",
    "schemas",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "coral-schemas": "bin/coral-schemas.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "require": "./dist/node.cjs",
      "import": "./dist/node.mjs"
    },
    "./schemas": "./schemas/index.schema.json",
    "./schemas/*": "./schemas/*.schema.json"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "dev": "tsup --watch",
    "build": "tsup && npm run schemas:generate",
    "schemas:generate": "node scripts/generate-schemas.js",
    "lint": "eslint src --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "eslint src --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "typecheck": "tsc --noEmit",
    "semantic-release": "semantic-release"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "keywords": [
    "ui",
    "core",
    "utility",
    "library",
    "reallygoodwork",
    "design-to-code",
    "json-schema"
  ],
  "author": "Really Good Work Inc. <hey@reallygood.work> (https://reallygood.work)",
  "license": "MIT",
  "devDependencies": {
    "@babel/types": "^7.27.4",
    "@eslint/js": "^9.11.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@reallygoodwork/coral-typescript-config": "workspace:*",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.5.4",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "type-fest": "^4.26.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.35.0",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "colord": "^2.9.3",
    "node-html-parser": "^7.0.1"
  },
  "dependencies": {
    "@babel/generator": "^7.27.4",
    "@babel/parser": "^7.27.4",
    "@babel/traverse": "^7.27.4",
    "@reallygoodwork/coral-tw2css": "workspace:*",
    "commander": "^12.0.0"
  }
}
