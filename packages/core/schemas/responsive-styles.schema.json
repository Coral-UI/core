                          },
                          "required": ["r", "g", "b", "a"],
                          "additionalProperties": false
                        },
                        "hsl": {
                          "type": "object",
                          "properties": {
                            "h": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 360
                            },
                            "s": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "l": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "a": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": ["h", "s", "l", "a"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["hex", "rgb", "hsl"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "angle": {
                          "description": "The angle of the gradient",
                          "type": "number"
                        },
                        "type": {
                          "description": "The type of the gradient",
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "linear"
                            },
                            {
                              "type": "string",
                              "const": "radial"
                            },
                            {
                              "type": "string",
                              "const": "LINEAR"
                            },
                            {
                              "type": "string",
                              "const": "RADIAL"
                            }
                          ]
                        },
                        "colors": {
                          "description": "The color stops of the gradient",
                          "type": "array",
                          "items": {
                            "description": "An object representing a single color stop in the gradient",
                            "type": "object",
                            "properties": {
                              "color": {
                                "type": "object",
                                "properties": {
                                  "hex": {
                                    "type": "string"
                                  },
                                  "rgb": {
                                    "type": "object",
                                    "properties": {
