                                "b": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 255
                                },
                                "a": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                }
                              },
                              "required": ["r", "g", "b", "a"],
                              "additionalProperties": false
                            },
                            "hsl": {
                              "type": "object",
                              "properties": {
                                "h": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 360
                                },
                                "s": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 100
                                },
                                "l": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 100
                                },
                                "a": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                }
                              },
                              "required": ["h", "s", "l", "a"],
                              "additionalProperties": false
                            }
                          },
                          "required": ["hex", "rgb", "hsl"],
                          "additionalProperties": false
                        },
                        "position": {
                          "description": "The position of the color in the gradient",
                          "type": "number"
                        }
                      },
                      "required": ["color", "position"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["angle", "type", "colors"],
                "additionalProperties": false
              },
              {
                "anyOf": [
                  {
                    "description": "A dimension value in pixels",
                    "type": "number"
                  },
                  {
                    "description": "A dimension value with explicit unit",
                    "type": "object",
                    "properties": {
                      "value": {
                        "description": "The numeric value of the dimension",
                        "type": "number"
                      },
                      "unit": {
                        "description": "The unit of measurement",
                        "type": "string",
                        "enum": [
                          "px",
                          "em",
                          "rem",
                          "vw",
                          "vh",
                          "vmin",
                          "vmax",
                          "%",
                          "ch",
                          "ex",
                          "cm",
                          "mm",
                          "in",
                          "pt",
                          "pc"
                        ]
                      }
                    },
                    "required": ["value", "unit"],
                    "additionalProperties": false
                  }
                ]
              }
            ]
          },
          {
            "description": "A nested style property",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "description": "The value of a style property",
                  "anyOf": [
