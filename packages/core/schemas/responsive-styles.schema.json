                                      },
                                      "b": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 255
                                      },
                                      "a": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 1
                                      }
                                    },
                                    "required": ["r", "g", "b", "a"],
                                    "additionalProperties": false
                                  },
                                  "hsl": {
                                    "type": "object",
                                    "properties": {
                                      "h": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 360
                                      },
                                      "s": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                      },
                                      "l": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                      },
                                      "a": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 1
