                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 255
                                      },
                                      "b": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 255
                                      },
                                      "a": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 1
                                      }
                                    },
                                    "required": ["r", "g", "b", "a"],
                                    "additionalProperties": false
                                  },
                                  "hsl": {
                                    "type": "object",
                                    "properties": {
                                      "h": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 360
                                      },
                                      "s": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                      },
                                      "l": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                      },
                                      "a": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 1
                                      }
                                    },
                                    "required": ["h", "s", "l", "a"],
                                    "additionalProperties": false
                                  }
                                },
                                "required": ["hex", "rgb", "hsl"],
                                "additionalProperties": false
                              },
                              "position": {
                                "description": "The position of the color in the gradient",
                                "type": "number"
                              }
                            },
                            "required": ["color", "position"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["angle", "type", "colors"],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "$ref": "#/$defs/__schema0"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "$id": "https://schemas.coral.design/v0.0.0/schema.json",
  "version": "0.0.0"
}
