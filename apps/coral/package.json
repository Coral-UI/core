{
  "name": "@reallygoodwork/coral-figma",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n tsc,build,vite 'pnpm:tsc:watch' 'pnpm:build:watch' 'vite'",
    "build:main": "NODE_ENV=production node esbuild.config.js",
    "build:ui": "pnpm vite build --emptyOutDir=false",
    "build:watch": "concurrently -n plugin,ui \"node esbuild.config.js\" \"pnpm build:ui --watch\"",
    "build": "pnpm build:ui && pnpm build:main",
    "tsc:watch": "pnpm tsc --watch --preserveWatchOutput"
  },
  "author": "Really Good Work Inc. <hey@reallygood.work> (https://reallygood.work)",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.3",
    "@eslint/js": "^9.11.1",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@reallygoodwork/coral-core": "workspace:*",
    "@reallygoodwork/coral-eslint-config": "workspace:*",
    "@reallygoodwork/coral-to-html": "workspace:*",
    "@reallygoodwork/coral-typescript-config": "workspace:*",
    "@reallygoodwork/react-to-coral": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@uiw/react-codemirror": "^4.25.2",
    "@vitejs/plugin-react": "^4.3.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "esbuild": "^0.25.5",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.13",
    "terser": "^5.44.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.4",
    "vite": "^7.0.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-singlefile": "^2.2.0",
    "zustand": "5.0.0-rc.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@uiw/codemirror-theme-copilot": "^4.25.2",
    "@uiw/codemirror-theme-github": "^4.25.2",
    "class-variance-authority": "^0.7.1",
    "colord": "^2.9.3",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1"
  }
}
