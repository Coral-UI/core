{
  "name": "@reallygoodwork/coral-figma",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n tsc,build,vite 'pnpm:tsc:watch' 'pnpm:build:watch' 'vite'",
    "build:main": "esbuild src/plugin/code.ts --bundle --target=es6 --format=cjs --platform=browser --outfile=dist/code.js",
    "build:ui": "pnpm vite build --emptyOutDir=false",
    "build:watch": "concurrently -n plugin,ui \"pnpm build:main --watch\" \"pnpm build:ui --watch\"",
    "build": "pnpm build:ui && pnpm build:main --minify",
    "tsc:watch": "pnpm tsc --watch --preserveWatchOutput"
  },
  "author": "Really Good Work Inc. <hey@reallygood.work> (https://reallygood.work)",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.3",
    "@eslint/js": "^9.11.1",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@reallygoodwork/coral-core": "workspace:*",
    "@reallygoodwork/coral-eslint-config": "workspace:*",
    "@reallygoodwork/coral-to-html": "workspace:*",
    "@reallygoodwork/coral-typescript-config": "workspace:*",
    "@reallygoodwork/react-to-coral": "workspace:*",
    "@tailwindcss/vite": "4.0.0-alpha.25",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@uiw/react-codemirror": "^4.23.3",
    "@vitejs/plugin-react": "^4.3.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "esbuild": "^0.25.5",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.6.0",
    "tailwindcss": "4.0.0-alpha.25",
    "typescript": "^5.5.4",
    "vite": "^5.4.7",
    "vite-plugin-node-polyfills": "^0.17.0",
    "vite-plugin-singlefile": "^2.0.2",
    "zustand": "5.0.0-rc.2"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@uiw/codemirror-theme-copilot": "^4.23.6",
    "@uiw/codemirror-theme-github": "^4.23.6",
    "colord": "^2.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
